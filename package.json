{
  "name": "qiongli-docs",
  "private": true,
  "workspaces": [
    "packages/npm-qiongli"
  ],
  "scripts": {
    "validate": "python3 scripts/validate_marketplace_install.py && npm --prefix packages/npm-qiongli test",
    "mcpb:pack": "python3 scripts/build_literature_mcpb.py --dist-dir dist",
    "mcpb:pack:full": "python3 scripts/build_full_desktop_mcpb.py --dist-dir dist",
    "acceptance:host:preflight": "cargo run --locked --manifest-path packages/qiongli-native/Cargo.toml --package qiongli --example native_host_acceptance_contract -- fixture tooling/release/acceptance/fixtures/alpha2-host-driven-v1.json",
    "desktop:check": "pnpm --dir packages/qiongli-desktop check",
    "desktop:test": "pnpm --dir packages/qiongli-app-api test && pnpm --dir packages/qiongli-desktop test",
    "desktop:build": "pnpm --dir packages/qiongli-desktop build",
    "desktop:macos": "bash scripts/build_macos_app.sh",
    "desktop:macos:open": "bash scripts/build_macos_app.sh --open",
    "desktop:macos:acceptance": "bash scripts/build_macos_acceptance_app.sh",
    "desktop:macos:acceptance:open": "bash scripts/build_macos_acceptance_app.sh --open",
    "docs:dev": "vitepress dev docs --host",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs --host"
  },
  "devDependencies": {
    "vitepress": "^1.6.4"
  },
  "packageManager": "pnpm@11.13.1"
}
