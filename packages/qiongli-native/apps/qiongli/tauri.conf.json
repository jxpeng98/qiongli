{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Qiongli",
  "identifier": "io.github.jxpeng98.qiongli",
  "build": {
    "beforeDevCommand": "pnpm --dir ../../../qiongli-desktop dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm --dir ../../../qiongli-desktop build",
    "frontendDist": "../../../qiongli-desktop/build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Qiongli 2",
        "width": 1180,
        "height": 780,
        "minWidth": 760,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self' customprotocol: asset:; connect-src ipc: http://ipc.localhost; img-src 'self' asset: data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self'; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": false,
    "icon": []
  }
}
