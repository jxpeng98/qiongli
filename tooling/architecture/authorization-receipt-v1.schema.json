{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qiongli.dev/schemas/authorization-receipt/v1",
  "title": "Qiongli Authorization Receipt V1",
  "description": "Redacted immutable evidence of one scoped authorization decision; never a bearer credential.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "authorization_id",
    "action",
    "object_scope",
    "actor_role",
    "authorizer_role",
    "project_or_source_revision",
    "plan_digest_sha256",
    "artifact_digests_sha256",
    "data_classification",
    "decision",
    "constraints",
    "reason_code",
    "issued_at",
    "expires_at",
    "evidence_refs"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "record_type": {
      "const": "qiongli-authorization-receipt"
    },
    "authorization_id": {
      "type": "string",
      "pattern": "^auth_[0-9a-f]{32}$"
    },
    "action": {
      "type": "string",
      "enum": [
        "research.preview-mutation",
        "research.apply-mutation",
        "research.destructive-mutation",
        "research.move-restricted-data",
        "repository.edit",
        "repository.stage",
        "repository.commit",
        "repository.push",
        "repository.pr-open-update",
        "repository.merge",
        "publication.publish-release"
      ]
    },
    "object_scope": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
      }
    },
    "actor_role": {
      "type": "string",
      "enum": [
        "requester-task-owner",
        "contributor-agent-operator",
        "maintainer",
        "codeowner-specialist-reviewer",
        "researcher-reviewer-pi",
        "data-steward-ethics-authority",
        "release-approver",
        "agent-ci-principal"
      ]
    },
    "authorizer_role": {
      "type": "string",
      "enum": [
        "requester-task-owner",
        "contributor-agent-operator",
        "maintainer",
        "codeowner-specialist-reviewer",
        "researcher-reviewer-pi",
        "data-steward-ethics-authority",
        "release-approver"
      ]
    },
    "project_or_source_revision": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|project-revision:[1-9][0-9]{0,19})$"
    },
    "plan_digest_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "artifact_digests_sha256": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "data_classification": {
      "type": "string",
      "enum": [
        "public",
        "internal",
        "confidential",
        "restricted",
        "regulated"
      ]
    },
    "decision": {
      "type": "string",
      "enum": [
        "approved",
        "denied",
        "revoked",
        "expired"
      ]
    },
    "constraints": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
      }
    },
    "reason_code": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9._:#/-]{0,255}$"
      }
    }
  },
  "allOf": [
    {
      "anyOf": [
        {
          "properties": {
            "plan_digest_sha256": {
              "type": "string"
            }
          }
        },
        {
          "properties": {
            "artifact_digests_sha256": {
              "minItems": 1
            }
          }
        }
      ]
    }
  ],
  "examples": [
    {
      "schema_version": "1.0",
      "record_type": "qiongli-authorization-receipt",
      "authorization_id": "auth_0123456789abcdef0123456789abcdef",
      "action": "repository.commit",
      "object_scope": [
        "repository-qiongli",
        "paths-tooling-architecture"
      ],
      "actor_role": "contributor-agent-operator",
      "authorizer_role": "requester-task-owner",
      "project_or_source_revision": "0000000000000000000000000000000000000000",
      "plan_digest_sha256": "1111111111111111111111111111111111111111111111111111111111111111",
      "artifact_digests_sha256": [],
      "data_classification": "internal",
      "decision": "approved",
      "constraints": [
        "explicit-paths-only",
        "preserve-unrelated-work"
      ],
      "reason_code": "task-scope-approved",
      "issued_at": "2026-08-18T16:00:00Z",
      "expires_at": "2026-08-18T18:00:00Z",
      "evidence_refs": [
        "task-authorization-policy-receipts",
        "check-local-green"
      ]
    }
  ]
}
