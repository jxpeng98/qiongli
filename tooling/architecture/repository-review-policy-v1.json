    "target": "branch",
    "enforcement": "active",
    "ref_include": [
      "refs/heads/2.x"
    ],
    "ref_exclude": [],
    "bypass_actors": [],
    "rules": [
      "deletion",
      "non_fast_forward",
      "pull_request",
      "required_status_checks"
    ],
    "pull_request": {
