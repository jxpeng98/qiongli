{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qiongli.dev/schemas/tools/qiongli_literature_search.marketplace-lite.input.v2.json",
  "title": "qiongli_literature_search marketplace-lite input",
  "type": "object",
  "required": [
    "query"
  ],
  "properties": {
    "query": {
      "type": "string"
    },
    "search_mode": {
      "type": "string",
      "enum": [
        "auto",
        "topic",
        "review",
        "systematic_review",
        "title",
        "doi"
      ],
      "description": "title/doi confirm normalized exact identity among bounded provider candidates; they do not prove exhaustive coverage."
    },
    "providers": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "openalex",
          "semantic_scholar",
          "crossref",
          "pubmed",
          "arxiv"
        ]
      },
      "uniqueItems": true
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 200
    },
    "per_provider_limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 200
    },
    "total_limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "from_year": {
      "type": "integer",
      "minimum": 1000,
      "maximum": 9999,
      "description": "Inclusive publication-year filter on returned candidates; unknown years are excluded. from_year must not exceed to_year."
    },
    "to_year": {
      "type": "integer",
      "minimum": 1000,
      "maximum": 9999,
      "description": "Inclusive publication-year filter on returned candidates; unknown years are excluded. from_year must not exceed to_year."
    },
    "venue_filter": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "description": "Normalized exact venue match on bounded returned candidates; unknown venues are excluded. This is not exhaustive provider-side filtering."
    }
  },
  "additionalProperties": false
}
