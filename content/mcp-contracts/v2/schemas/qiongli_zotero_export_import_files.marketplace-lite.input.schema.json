{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qiongli.dev/schemas/tools/qiongli_zotero_export_import_files.input.v2.json",
  "title": "qiongli_zotero_export_import_files input",
  "type": "object",
  "properties": {
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "title",
          "provider"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "provider": {
            "type": "string"
          },
          "doi": {
            "type": [
              "string",
              "null"
            ]
          },
          "venue": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "url": {
            "type": [
              "string",
              "null"
            ]
          },
          "record_type": {
            "type": [
              "string",
              "null"
            ]
          },
          "published_date": {
            "type": [
              "string",
              "null"
            ]
          },
          "volume": {
            "type": [
              "string",
              "null"
            ]
          },
          "issue": {
            "type": [
              "string",
              "null"
            ]
          },
          "pages": {
            "type": [
              "string",
              "null"
            ]
          },
          "publisher": {
            "type": [
              "string",
              "null"
            ]
          },
          "citekey": {
            "type": [
              "string",
              "null"
            ]
          },
          "year": {
            "type": [
              "integer",
              "null"
            ]
          },
          "providers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "authors": {
            "type": "array",
            "description": "Ordered authors. Preserve supplied family/given names or literal corporate/unparsed names; never guess a name split.",
            "items": {
              "type": "object",
              "properties": {
                "family": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "given": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "literal": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "additionalProperties": false
            }
          },
          "metadata_conflicts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      },
      "description": "Bibliographic record objects, not serialized JSON strings. Metadata provenance is not proof of identity verification. Omit unknown optional fields."
    },
    "formats": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "references.json",
          "references.ris",
          "bibliography.bib",
          "zotero-import-report.md"
        ]
      },
      "uniqueItems": true
    }
  },
  "additionalProperties": false
}
