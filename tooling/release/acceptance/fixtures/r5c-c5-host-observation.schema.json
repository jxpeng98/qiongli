{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qiongli.dev/schemas/r5c-c5-host-observation.schema.json",
  "title": "Qiongli R5C C5 Live Host Observation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "recordType",
    "hostFamily",
    "hostVersion",
    "observedToolIds",
    "evidenceResultSha256s",
    "acceptedCandidateSha256",
    "reviewResult",
    "checkpointTransitions",
    "verdict"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "recordType": {
      "const": "qiongli-host-acceptance-observation"
    },
    "hostFamily": {
      "enum": [
        "codex",
        "claude-code"
      ]
    },
    "hostVersion": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._+-]{1,96}$"
    },
    "observedToolIds": {
      "const": [
        "qiongli_project_graph_snapshot",
        "qiongli_project_read"
      ]
    },
    "evidenceResultSha256s": {
      "type": "array",
      "minItems": 2,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/sha256"
      }
    },
    "acceptedCandidateSha256": {
      "$ref": "#/$defs/sha256"
    },
    "reviewResult": {
      "const": "pass"
    },
    "checkpointTransitions": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "prefixItems": [
        {
          "$ref": "#/$defs/candidateAccepted"
        },
        {
          "$ref": "#/$defs/reviewAccepted"
        },
        {
          "$ref": "#/$defs/checkpointPersisted"
        }
      ],
      "items": false
    },
    "verdict": {
      "$ref": "#/$defs/verdict"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transition",
        "fromGeneration",
        "toGeneration",
        "fromDocumentSha256",
        "toDocumentSha256"
      ],
      "properties": {
        "transition": {
          "type": "string"
        },
        "fromGeneration": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "toGeneration": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "fromDocumentSha256": {
          "$ref": "#/$defs/sha256"
        },
        "toDocumentSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "candidateAccepted": {
      "allOf": [
        {
          "$ref": "#/$defs/transition"
        },
        {
          "properties": {
            "transition": {
              "const": "candidate-accepted"
            }
          }
        }
      ]
    },
    "reviewAccepted": {
      "allOf": [
        {
          "$ref": "#/$defs/transition"
        },
        {
          "properties": {
            "transition": {
              "const": "review-accepted"
            }
          }
        }
      ]
    },
    "checkpointPersisted": {
      "allOf": [
        {
          "$ref": "#/$defs/transition"
        },
        {
          "properties": {
            "transition": {
              "const": "checkpoint-persisted"
            }
          }
        }
      ]
    },
    "verdict": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projectReadObserved",
        "evidenceGroundedCandidate",
        "unresolvedGapReportObserved",
        "reviewResultObserved",
        "checkpointPersisted",
        "providerCredentialCount",
        "directModelRequestCount",
        "qiongliModelCliChildCount",
        "privatePayloadPersistedCount",
        "staleProjectRevisionRejectionCount",
        "checkpointDigestRejectionCount",
        "undeclaredEvidenceRejectionCount",
        "unknownFieldRejectionCount"
      ],
      "properties": {
        "projectReadObserved": {
          "const": true
        },
        "evidenceGroundedCandidate": {
          "const": true
        },
        "unresolvedGapReportObserved": {
          "const": true
        },
        "reviewResultObserved": {
          "const": true
        },
        "checkpointPersisted": {
          "const": true
        },
        "providerCredentialCount": {
          "const": 0
        },
        "directModelRequestCount": {
          "const": 0
        },
        "qiongliModelCliChildCount": {
          "const": 0
        },
        "privatePayloadPersistedCount": {
          "const": 0
        },
        "staleProjectRevisionRejectionCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "checkpointDigestRejectionCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "undeclaredEvidenceRejectionCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "unknownFieldRejectionCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        }
      }
    }
  }
}
